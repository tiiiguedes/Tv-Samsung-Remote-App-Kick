<Window x:Class="ControleSamsung.RemoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controle Samsung" Width="352" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="ShowWhenChecked" />
    <Style x:Key="RemoteCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource RemoteCardFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RemoteCardStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="20" />
    </Style>
    <Style x:Key="CardHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.78" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Glyph" TargetType="Path">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" />
      <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>
    <Style x:Key="RoundKey" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="42" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource RemoteKeyFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RemoteKeyStroke}" />
      <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Ellipse x:Name="Surface" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Fill" Value="{DynamicResource RemoteKeyHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Fill" Value="{DynamicResource RemoteKeyPressed}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <EventSetter Event="Click" Handler="KeyClicked" />
    </Style>
    <Style x:Key="DirectionKey" TargetType="Button" BasedOn="{StaticResource RoundKey}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="46" />
    </Style>
    <Style x:Key="UtilityKey" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="34" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Padding" Value="0" />
      <EventSetter Event="Click" Handler="KeyClicked" />
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,15,16,16">
      <Grid Margin="0,0,0,7">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource RoundKey}" Tag="KEY_POWER" Width="38" Height="38"
                IsEnabled="{Binding IsEnabled, ElementName=RemoteButtons}"
                Foreground="{DynamicResource RemotePowerInk}" ToolTip="Energia"
                AutomationProperties.Name="Ligar ou desligar a TV" Margin="0,0,11,0">
          <Path Style="{StaticResource Glyph}" Width="18" Height="18"
                Data="M 8,0 L 8,8 M 4,2 A 7,7 0 1 0 12,2" />
        </Button>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Controle da TV" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="Samsung CU8000" Opacity="0.71" FontSize="11" Margin="0,1,0,0" />
        </StackPanel>
        <ToggleButton x:Name="ConnectionToggle" Grid.Column="2" Width="32" Height="32"
                      Padding="0" Margin="0,0,5,0" ToolTip="Conexão"
                      AutomationProperties.Name="Mostrar opções de conexão">
          <TextBlock Text="&#xE701;" FontFamily="Segoe Fluent Icons" FontSize="14" />
        </ToggleButton>
        <Button Grid.Column="3" Width="32" Height="32" Padding="0"
                AutomationProperties.Name="Recolher painel" ToolTip="Recolher (Esc)" Click="HideClicked">
          <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12" />
        </Button>
      </Grid>

      <TextBlock x:Name="StatusLine" Text="Ligue a TV e clique em Procurar TV."
                 AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap"
                 Opacity="0.8" Margin="2,0,2,8" MinHeight="17" FontSize="11.5" />
      <Border Style="{StaticResource RemoteCard}" Padding="10" Margin="0,0,0,10"
              Visibility="{Binding IsChecked, ElementName=ConnectionToggle, Converter={StaticResource ShowWhenChecked}}">
        <StackPanel>
          <ComboBox x:Name="TvSelector" IsEditable="True" HorizontalAlignment="Stretch" MinHeight="32"
                    AutomationProperties.Name="TV na rede ou endereço IP" />
          <UniformGrid Columns="2" Margin="-3,5,-3,-3">
            <Button x:Name="SearchButton" Content="Procurar TV" Click="SearchClicked"
                    HorizontalAlignment="Stretch" Margin="3" Height="32" />
            <Button x:Name="ConnectButton" Content="Conectar" Click="ConnectClicked"
                    Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                    Margin="3" Height="32" />
          </UniformGrid>
        </StackPanel>
      </Border>

      <StackPanel x:Name="RemoteButtons" IsEnabled="False">
        <UniformGrid Columns="2" Margin="-5,0,-5,10">
          <Border Style="{StaticResource RemoteCard}" Margin="5,0" Padding="13,8,10,8">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="46" /></Grid.RowDefinitions>
              <TextBlock Text="VOLUME" Style="{StaticResource CardHeading}" />
              <Button Grid.Column="1" Style="{StaticResource RoundKey}" Tag="KEY_VOLUP"
                      ToolTip="Aumentar volume" AutomationProperties.Name="Aumentar volume">
                <Path Style="{StaticResource Glyph}" Data="M 0,7 L 14,7 M 7,0 L 7,14" />
              </Button>
              <Button Grid.Row="1" Style="{StaticResource RoundKey}" Tag="KEY_MUTE" HorizontalAlignment="Left"
                      ToolTip="Mudo" AutomationProperties.Name="Mudo">
                <Path Style="{StaticResource Glyph}" Data="M 1,5 L 4,5 L 8,1 L 8,13 L 4,9 L 1,9 Z M 11,5 L 15,9 M 15,5 L 11,9" />
              </Button>
              <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundKey}" Tag="KEY_VOLDOWN"
                      ToolTip="Abaixar volume" AutomationProperties.Name="Abaixar volume">
                <Path Style="{StaticResource Glyph}" Data="M 0,0 L 14,0" />
              </Button>
            </Grid>
          </Border>
          <Border Style="{StaticResource RemoteCard}" Margin="5,0" Padding="13,8,10,8">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="46" /></Grid.RowDefinitions>
              <TextBlock Text="CANAIS" Style="{StaticResource CardHeading}" />
              <Button Grid.Column="1" Style="{StaticResource RoundKey}" Tag="KEY_CHUP"
                      ToolTip="Próximo canal" AutomationProperties.Name="Próximo canal">
                <Path Style="{StaticResource Glyph}" Data="M 0,8 L 7,1 L 14,8" />
              </Button>
              <Button Grid.Row="1" Style="{StaticResource RoundKey}" Tag="KEY_GUIDE" HorizontalAlignment="Left"
                      ToolTip="Guia" AutomationProperties.Name="Guia de canais">
                <Path Style="{StaticResource Glyph}" Data="M 1,1 L 15,1 L 15,12 L 1,12 Z M 1,6 L 15,6 M 6,1 L 6,6 M 4,9 L 12,9" />
              </Button>
              <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundKey}" Tag="KEY_CHDOWN"
                      ToolTip="Canal anterior" AutomationProperties.Name="Canal anterior">
                <Path Style="{StaticResource Glyph}" Data="M 0,1 L 7,8 L 14,1" />
              </Button>
            </Grid>
          </Border>
        </UniformGrid>

        <Border Style="{StaticResource RemoteCard}" Padding="10,12,10,10">
          <StackPanel>
            <Grid Width="202" Height="202" HorizontalAlignment="Center">
              <Ellipse Fill="{DynamicResource RemoteDialFill}" Stroke="{DynamicResource RemoteDialStroke}" StrokeThickness="2" />
              <Ellipse Margin="3" Stroke="{DynamicResource RemoteCardStroke}" />
              <Grid Margin="5">
                <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="76" /><RowDefinition /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="76" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Button Grid.Column="1" Style="{StaticResource DirectionKey}" Tag="KEY_UP" AutomationProperties.Name="Cima">
                  <Path Style="{StaticResource Glyph}" Width="12" Height="12" Data="M 0,6 L 6,0 L 12,6" />
                </Button>
                <Button Grid.Row="1" Style="{StaticResource DirectionKey}" Tag="KEY_LEFT" AutomationProperties.Name="Esquerda">
                  <Path Style="{StaticResource Glyph}" Width="12" Height="12" Data="M 6,0 L 0,6 L 6,12" />
                </Button>
                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundKey}" Tag="KEY_ENTER"
                        Width="70" Height="70" Content="OK" FontSize="17" FontWeight="SemiBold" />
                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource DirectionKey}" Tag="KEY_RIGHT" AutomationProperties.Name="Direita">
                  <Path Style="{StaticResource Glyph}" Width="12" Height="12" Data="M 0,0 L 6,6 L 0,12" />
                </Button>
                <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource DirectionKey}" Tag="KEY_DOWN" AutomationProperties.Name="Baixo">
                  <Path Style="{StaticResource Glyph}" Width="12" Height="12" Data="M 0,0 L 6,6 L 12,0" />
                </Button>
              </Grid>
            </Grid>
            <UniformGrid Columns="3" Margin="0,10,0,0">
              <Button Style="{StaticResource UtilityKey}" Tag="KEY_RETURN" ToolTip="Voltar" AutomationProperties.Name="Voltar">
                <Path Style="{StaticResource Glyph}" Data="M 6,0 L 0,6 L 6,12 M 1,6 H 11 A 4,4 0 0 1 11,14 H 6" />
              </Button>
              <Button Style="{StaticResource UtilityKey}" Tag="KEY_HOME" ToolTip="Início" AutomationProperties.Name="Início">
                <Path Style="{StaticResource Glyph}" Data="M 1,7 L 8,1 L 15,7 V 15 H 10 V 10 H 6 V 15 H 1 Z" />
              </Button>
              <Button Style="{StaticResource UtilityKey}" Tag="KEY_SOURCE" ToolTip="Fonte" AutomationProperties.Name="Fonte de entrada">
                <Path Style="{StaticResource Glyph}" Data="M 8,1 H 15 V 15 H 8 M 0,8 H 11 M 7,4 L 11,8 L 7,12" />
              </Button>
            </UniformGrid>
          </StackPanel>
        </Border>
      </StackPanel>

      <TextBlock Text="APLICATIVOS" Style="{StaticResource CardHeading}" Margin="2,12,0,6" />
      <UniformGrid x:Name="AppButtons" Columns="2" Margin="-4,-2,-4,0" IsEnabled="False">
        <Button Content="YouTube" Tag="111299001912" Click="AppClicked"
                HorizontalAlignment="Stretch" Margin="4,2" Height="39" />
        <Button Content="Twitch" Tag="3202203026841" Click="AppClicked"
                HorizontalAlignment="Stretch" Margin="4,2" Height="39" />
        <Button Content="Kick" Click="KickClicked"
                HorizontalAlignment="Stretch" Margin="4,2" Height="39" />
        <Button Content="Instalar Kick" Click="InstallKickClicked"
                ToolTip="Instala o player Kick na TV conectada"
                HorizontalAlignment="Stretch" Margin="4,2" Height="39" />
      </UniformGrid>
    </StackPanel>
  </ScrollViewer>
</Window>
